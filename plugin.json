{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pohuy",
  "version": "0.3.0",
  "description": "Инженерный стиль общения на русском с сохранением режима и настройкой интенсивности.",
  "author": {
    "name": "Serge Shima",
    "url": "https://github.com/smixs"
  },
  "repository": "https://github.com/smixs/pohuy",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "hooks": "./codex/hooks.json",
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "Pohuy",
        "shortDescription": "Режим общения на русском",
        "longDescription": "Автоматически загружает стиль, восстанавливает его после сжатия контекста и сохраняет выбранную интенсивность между сессиями. Проектные артефакты сохраняют принятый язык и профессиональные формулировки.",
        "developerName": "Serge Shima",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Настрой режим общения Pohuy.",
          "Покажи текущий режим Pohuy.",
          "Выключи стиль Pohuy."
        ],
        "websiteURL": "https://github.com/smixs/pohuy",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
