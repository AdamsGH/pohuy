{
  "name": "pohuy",
  "version": "0.1.0",
  "description": "Session-scoped Russian engineering response style for Pi",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --import tsx --test extensions/pohuy.test.ts",
    "typecheck": "tsc --noEmit",
    "test:codex": "python3 -m unittest discover -s codex/tests -p 'test_*.py' -v",
    "test:codex:integration": "POHUY_CODEX_INTEGRATION=1 python3 -m unittest discover -s codex/tests -p test_codex_integration.py -v"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    "assets/",
    "codex/mcp.json",
    ".agents/plugins/marketplace.json",
    "codex/AGENTS-pohuy.md",
    "codex/hooks.json",
    "codex/pohuy.py",
    "codex/settings_mcp.py",
    "codex/migration.py",
    "codex/package.py",
    "codex/skills/",
    "codex/README.md",
    "commands/",
    "docs/",
    "extensions/pohuy.ts",
    "extensions/pohuy/",
    "extensions/README.md",
    "skills/",
    "ЧЕСТНЫЕ-ЦИФРЫ.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./extensions/pohuy.ts"
    ]
  }
}
